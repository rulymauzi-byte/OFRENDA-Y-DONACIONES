rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo cuentas de Google (no anónimas)
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isOwner(owner) { return signedIn() && request.auth.uid == owner; }
    function memberPath(owner) { return /databases/$(database)/documents/lists/$(owner)/members/$(request.auth.uid); }
    function isMember(owner) {
      return signedIn() && exists(memberPath(owner))
             && get(memberPath(owner)).data.expiresAt > request.time.toMillis();
    }
    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }
    // El dispositivo que escribe debe estar registrado y no bloqueado por el administrador
    function devPath(owner, dev) { return /databases/$(database)/documents/lists/$(owner)/devices/$(dev); }
    function devOk(owner) {
      return request.resource.data.dev is string
             && exists(devPath(owner, request.resource.data.dev))
             && get(devPath(owner, request.resource.data.dev)).data.blocked != true;
    }

    // Lista de cada cuenta
    match /lists/{owner} {
      allow read, write: if isOwner(owner);
      allow get: if isMember(owner);

      // Registros: el dueño y los invitados con acceso vigente
      match /records/{id} {
        allow read: if isOwner(owner) || isMember(owner);
        allow write: if (isOwner(owner) && devOk(owner)) || isMember(owner);
      }

      // Dispositivos de la cuenta y datos del administrador
      match /devices/{dev} {
        allow read, write: if isOwner(owner);
      }
      match /meta/{doc} {
        allow read, write: if isOwner(owner);
      }

      // Invitados: el dueño los ve y los quita; cada invitado se agrega a sí mismo con un código válido
      match /members/{uid} {
        allow read, delete: if isOwner(owner);
        allow get: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
          && invite(request.resource.data.code).owner == owner
          && invite(request.resource.data.code).expiresAt > request.time.toMillis()
          && request.resource.data.expiresAt == invite(request.resource.data.code).expiresAt;
      }
    }

    // Códigos temporales de invitación
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Listas a las que cada persona se unió
    match /users/{uid}/{rest=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
