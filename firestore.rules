rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada lista vive en rooms/{CÓDIGO}/records/{id}.
    // Solo quien conoce el código puede leer/escribir esa lista.
    match /rooms/{room}/records/{recordId} {
      allow read, write: if request.auth != null
                         && room.size() >= 8
                         && (request.method == 'get' || request.method == 'list'
                             || (request.resource.data.keys().hasOnly(['name','amount','date','paid','createdAt','updatedAt','deleted'])
                                 && request.resource.data.name is string
                                 && request.resource.data.amount is number));
    }
    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
